PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:5173,https://taskflow.bohaus.in,taskflow-app://app
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=generate_a_long_random_database_password
DATABASE_URL=postgresql+asyncpg://taskflow:replace_with_url_encoded_password@postgres:5432/taskflow
SYNC_DATABASE_URL=postgresql://taskflow:replace_with_url_encoded_password@postgres:5432/taskflow
JWT_SECRET=generate_at_least_32_random_bytes
JWT_EXPIRES_MINUTES=10080

# Server-side model access. These values must never use a VITE_ prefix.
CHAT_PROVIDER=openai
# Prefer GROQ_API_KEY for the default Groq-compatible base URL. OPENAI_API_KEY
# remains supported for existing deployments and other compatible providers.
GROQ_API_KEY=
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
UPLOAD_DIR=/data/uploads
