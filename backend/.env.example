PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:5173,https://taskflow.bohaus.in

# Keep the existing TaskFlow agent tools and RLS by proxying the authenticated
# user request to the deployed Supabase Edge Function.
CHAT_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_AGENT_FUNCTION=agent-chat

# Optional direct OpenAI-compatible mode: set CHAT_PROVIDER=openai.
# These values are server-only and must never use a VITE_ prefix.
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
