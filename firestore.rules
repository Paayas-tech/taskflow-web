rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProjectMember(ownerId, memberId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'role',
          'status',
          'addedBy',
          'joinedAt',
          'updatedAt'
        ])
        && request.resource.data.userId == memberId
        && request.resource.data.status == 'active'
        && request.resource.data.addedBy == ownerId
        && (
          (memberId == ownerId && request.resource.data.role == 'owner')
          ||
          (memberId != ownerId && request.resource.data.role == 'member')
        );
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, create, update, delete:
        if signedInAs(userId);
    }

    match /users/{userId}/lists/{listId} {
      allow read, create, update, delete:
        if signedInAs(userId);
    }

    match /users/{userId}/projects/{projectId} {
      allow read, create, update, delete:
        if signedInAs(userId);
    }

    match /users/{ownerId}/projects/{projectId}/members/{memberId} {
      allow read: if signedInAs(ownerId)
        && exists(
          /databases/$(database)/documents/users/$(ownerId)/projects/$(projectId)
        );

      allow create: if signedInAs(ownerId)
        && exists(
          /databases/$(database)/documents/users/$(ownerId)/projects/$(projectId)
        )
        && validProjectMember(ownerId, memberId)
        && request.resource.data.joinedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedInAs(ownerId)
        && exists(
          /databases/$(database)/documents/users/$(ownerId)/projects/$(projectId)
        )
        && validProjectMember(ownerId, memberId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedInAs(ownerId)
        && resource.data.userId == memberId
        && (
          (memberId != ownerId && resource.data.role == 'member')
          || !existsAfter(
            /databases/$(database)/documents/users/$(ownerId)/projects/$(projectId)
          )
        );
    }
  }
}
