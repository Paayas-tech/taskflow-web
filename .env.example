# Calendar integration public configuration.
# Do not place client secrets, access tokens, refresh tokens, passwords, or
# Apple app-specific passwords in VITE_ variables; Vite exposes them to the browser.
VITE_GOOGLE_CALENDAR_CLIENT_ID=
VITE_GOOGLE_CALENDAR_REDIRECT_URI=
VITE_MICROSOFT_CALENDAR_CLIENT_ID=
VITE_MICROSOFT_CALENDAR_REDIRECT_URI=

# Secure server endpoints required for provider authorization/token handling.
VITE_CALENDAR_OAUTH_BACKEND_URL=
VITE_CALENDAR_CALDAV_BACKEND_URL=
