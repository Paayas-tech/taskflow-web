# Supabase browser configuration. Use the project URL and anon/publishable key;
# never expose the service-role key to Vite or other browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Calendar credentials are Supabase Edge Function secrets. Do not place
# GOOGLE_CLIENT_SECRET, GOOGLE_TOKEN_ENCRYPTION_KEY, or OAuth tokens here.
