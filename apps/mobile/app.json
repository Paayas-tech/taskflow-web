{
  "expo": {
    "name": "TaskFlow",
    "slug": "taskflow-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "taskflow",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.paayas.taskflow"
    },
    "ios": {
      "bundleIdentifier": "com.paayas.taskflow"
    }
  }
}
